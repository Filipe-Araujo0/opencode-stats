+def _clock_time(value: str) -> time:
+    if not re.fullmatch(r"\d{2}:\d{2}", value):
+        raise argparse.ArgumentTypeError("Informe o horário local no formato HH:MM (ex.: 09:30)")
+    try:
+        return time.fromisoformat(value)
