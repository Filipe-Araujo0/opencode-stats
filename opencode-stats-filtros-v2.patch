+def _session_model(value: str | None, schema: str) -> tuple[str | None, str | None]:
+    if schema != "session_v2" or value is None:
+        return value, None
+    try:
+        parsed = json.loads(value)
+    except (json.JSONDecodeError, TypeError):
+        return value, None
+    if not isinstance(parsed, dict):
